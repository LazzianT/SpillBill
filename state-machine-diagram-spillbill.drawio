        <mxCell id="YnwVOECAVnGj1yR-39HR-168" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Daftar Sales Order Ditampilkan&lt;/b&gt; : Keadaan setelah halaman Sales Order dimuat. Admin Marketing memilih salah satu aksi: input SO baru, edit SO, atau hapus SO." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4213.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-169" parent="1" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="4259.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-170" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Form Input / Edit SO Terbuka&lt;/b&gt; : Sistem memuat form input / edit SO. Admin memilih pelanggan dan produk serta mengisi data SO, lalu menekan Simpan / Batal. Jika pelanggan atau stok tidak ditemukan, pesan peringatan ditampilkan dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4253.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-171" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="4299.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-172" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Sales Order Tersimpan&lt;/b&gt; : Aksi tidak dibatalkan serta pelanggan dan stok ditemukan. Sistem memproses simpan SO lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4293.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-173" parent="1" style="rounded=0;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="4339.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-174" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Pembuatan Dibatalkan&lt;/b&gt; : Admin menekan Batal. Sistem menampilkan daftar SO tanpa menyimpan data." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4333.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-175" parent="1" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="4379.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-176" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Menunggu Konfirmasi Hapus&lt;/b&gt; : Admin memilih aksi Hapus SO. Sistem menunggu admin mengonfirmasi penghapusan data." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4373.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-177" parent="1" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="4419.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-178" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Sales Order Dihapus&lt;/b&gt; : Admin mengonfirmasi hapus. Sistem memproses hapus data Sales Order lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="4413.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-179" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f7fbff;strokeColor=#6c8ebf;" value="&lt;b&gt;Penjelasan Alur :&lt;/b&gt; Sistem diawali ketika Admin Marketing membuka menu Sales Order sehingga Daftar Sales Order Ditampilkan. Pada aksi input / edit, form dibuka dan admin menekan Simpan / Batal. Jika dibatalkan, daftar SO ditampilkan tanpa menyimpan (final state). Jika tidak dibatalkan, sistem memeriksa pelanggan dan stok: bila ditemukan maka SO tersimpan dan pesan sukses ditampilkan, bila tidak maka pesan peringatan muncul dan admin tetap di form. Pada aksi hapus, admin mengonfirmasi penghapusan lalu data SO dihapus dan pesan sukses ditampilkan." vertex="1">
          <mxGeometry height="92" width="980" x="364" y="4491.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-180" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;" value="STATE MACHINE DIAGRAM&lt;br&gt;MENCATAT PEMBAYARAN" vertex="1">
