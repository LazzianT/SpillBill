        <mxCell id="YnwVOECAVnGj1yR-39HR-219" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Riwayat Pembayaran Ditampilkan&lt;/b&gt; : Keadaan setelah menu pembayaran dibuka. Admin Accounting melihat riwayat dan memilih aksi: input, edit, atau hapus pembayaran." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5425.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-220" parent="1" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5471.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-221" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Form Pembayaran Terbuka&lt;/b&gt; : Sistem memuat form input / edit. Admin mengisi jumlah, tanggal, metode, dan memilih No. Invoice, lalu menekan Simpan / Batal. Jika nominal tidak sesuai tagihan, pesan peringatan ditampilkan dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5465.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-222" parent="1" style="rounded=0;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5511.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-223" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Aksi Dibatalkan&lt;/b&gt; : Admin menekan Batal. Sistem menampilkan riwayat pembayaran tanpa menyimpan data." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5505.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-224" parent="1" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5551.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-225" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Menunggu Konfirmasi Hapus&lt;/b&gt; : Admin menekan Hapus. Sistem menunggu admin mengonfirmasi penghapusan data pembayaran." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5545.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-226" parent="1" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5591.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-227" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Pembayaran Diproses&lt;/b&gt; : Sistem memverifikasi dan memproses data pembayaran (simpan / hapus). Hasil proses menentukan berhasil atau gagal disimpan." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5585.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-228" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5631.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-229" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Status Invoice Diperbarui&lt;/b&gt; : Pembayaran berhasil disimpan. Sistem memperbarui status invoice (Lunas / Sebagian) lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5625.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-230" parent="1" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="5671.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-231" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Pencatatan Dibatalkan&lt;/b&gt; : Pembayaran gagal disimpan. Sistem membatalkan pencatatan dan menampilkan pesan kesalahan." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="5665.200012207031" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-232" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f7fbff;strokeColor=#6c8ebf;" value="&lt;b&gt;Penjelasan Alur :&lt;/b&gt; Sistem diawali ketika Admin Accounting membuka menu pembayaran sehingga Riwayat Pembayaran Ditampilkan. Pada aksi input / edit, form dibuka dan admin menekan Simpan / Batal. Jika dibatalkan, riwayat ditampilkan tanpa menyimpan (final state). Jika nominal tidak sesuai tagihan, pesan peringatan muncul dan admin tetap di form; jika sesuai, data diproses. Pada aksi hapus, setelah admin mengonfirmasi, data juga diproses. Bila berhasil disimpan, status invoice diperbarui (Lunas / Sebagian) dan pesan sukses ditampilkan; bila gagal, pencatatan dibatalkan dan pesan kesalahan ditampilkan." vertex="1">
          <mxGeometry height="92" width="980" x="364" y="5743.200012207031" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
