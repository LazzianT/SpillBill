        <mxCell id="_iMzLf03uUKQm-mnQyBB-180" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Invoice Tercetak&lt;/b&gt; : Admin menekan tombol Cetak. Sistem memproses cetak invoice lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2082" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-181" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
