        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-126" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Invoice Tersimpan&lt;/b&gt; : Semua data sesuai. Sistem memproses simpan invoice lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="3121.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-127" parent="1" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" value="" vertex="1">
