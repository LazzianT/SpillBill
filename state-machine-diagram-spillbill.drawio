        <mxCell id="_iMzLf03uUKQm-mnQyBB-90" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Form Input / Edit SO Terbuka&lt;/b&gt; : Sistem memuat form. Admin memilih pelanggan dan produk serta mengisi data SO, lalu menekan Simpan / Batal. Jika pelanggan atau stok tidak ditemukan, pesan peringatan ditampilkan dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="705" x="380" y="2272.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-91" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="355" y="2318.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-92" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Sales Order Tersimpan&lt;/b&gt; : Aksi tidak dibatalkan serta pelanggan dan stok ditemukan. Sistem memproses simpan SO lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="705" x="380" y="2312.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-93" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="355" y="2358.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-94" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Pembuatan Dibatalkan&lt;/b&gt; : Admin menekan Batal. Sistem menampilkan daftar SO tanpa menyimpan data." vertex="1">
          <mxGeometry height="38" width="705" x="380" y="2352.2000122070312" as="geometry" />
