        <mxCell id="YnwVOECAVnGj1yR-39HR-122" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Daftar Invoice Ditampilkan&lt;/b&gt; : Keadaan setelah halaman invoice dimuat dan daftar invoice tampil. User memilih satu aksi: cetak, hapus, input, atau edit invoice." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="3041.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-123" parent="1" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="3087.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-124" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Form Input / Edit Terbuka&lt;/b&gt; : Sistem memuat form input / edit invoice (data bersumber dari Sales Order). User mengisi data lalu menekan Simpan. Jika data tidak sesuai, pesan error ditampilkan dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="3081.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-125" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
