        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-128" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Invoice Tercetak&lt;/b&gt; : User menekan tombol Cetak. Sistem memproses cetak invoice lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="3161.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-129" parent="1" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="3207.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-130" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Invoice Dihapus&lt;/b&gt; : User menekan tombol Hapus. Sistem memproses hapus data invoice lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="3201.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-131" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f7fbff;strokeColor=#6c8ebf;" value="&lt;b&gt;Penjelasan Alur :&lt;/b&gt; Sistem diawali ketika user membuka halaman invoice sehingga Daftar Invoice Ditampilkan. User kemudian memilih satu aksi. Pada aksi input / edit, form dibuka dan user menekan Simpan: jika semua data sesuai maka invoice tersimpan, jika tidak maka pesan error ditampilkan dan user tetap di form. Pada aksi cetak, invoice diproses menjadi Invoice Tercetak. Pada aksi hapus, data invoice diproses menjadi Invoice Dihapus. Seluruh aksi yang berhasil diakhiri dengan pesan sukses (final state)." vertex="1">
          <mxGeometry height="92" width="980" x="364" y="3279.2000122070312" as="geometry" />
        </mxCell>
