        <mxCell id="_iMzLf03uUKQm-mnQyBB-182" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Invoice Dihapus&lt;/b&gt; : Admin menekan tombol Hapus. Sistem memproses hapus data invoice lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2122" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-183" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#1f3d7a;" value="C. Mencatat Pembayaran" vertex="1">
          <mxGeometry height="24" width="600" x="1647" y="2162" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-184" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2198" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-185" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Riwayat Pembayaran Ditampilkan&lt;/b&gt; : Keadaan setelah menu pembayaran dibuka. Admin Invoice melihat riwayat dan memilih aksi: input, edit, atau hapus pembayaran." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2192" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-186" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2238" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-187" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Form Pembayaran Terbuka&lt;/b&gt; : Sistem memuat form. Admin mengisi jumlah, tanggal, metode, dan memilih No. Invoice, lalu menekan Simpan / Batal. Jika nominal tidak sesuai tagihan, pesan peringatan ditampilkan dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2232" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-188" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2278" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-189" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Aksi Dibatalkan&lt;/b&gt; : Admin menekan Batal. Sistem menampilkan riwayat pembayaran tanpa menyimpan data." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2272" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-190" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2318" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-191" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Menunggu Konfirmasi Hapus&lt;/b&gt; : Admin menekan Hapus. Sistem menunggu admin mengonfirmasi penghapusan data pembayaran." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2312" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-192" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2358" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-193" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Pembayaran Diproses&lt;/b&gt; : Sistem memverifikasi dan memproses data pembayaran (simpan / hapus). Hasil proses menentukan berhasil atau gagal disimpan." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2352" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-194" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2398" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-195" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Status Invoice Diperbarui&lt;/b&gt; : Pembayaran berhasil disimpan. Sistem memperbarui status invoice (Lunas / Sebagian) lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2392" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-196" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="1647" y="2438" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-197" parent="_iMzLf03uUKQm-mnQyBB-199" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Pencatatan Dibatalkan&lt;/b&gt; : Pembayaran gagal disimpan. Sistem membatalkan pencatatan dan menampilkan pesan kesalahan." vertex="1">
          <mxGeometry height="38" width="705" x="1672" y="2432" as="geometry" />
        </mxCell>
        <mxCell id="_iMzLf03uUKQm-mnQyBB-198" parent="_iMzLf03uUKQm-mnQyBB-199" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f7fbff;strokeColor=#6c8ebf;" value="&lt;b&gt;Penjelasan Alur :&lt;/b&gt; Sistem diawali ketika Admin Invoice membuka halaman login (initial state) sehingga Form Login Ditampilkan. Setelah username dan password diisi dan tombol Login ditekan, sistem Memvalidasi Kredensial. Jika valid, session dimuat dan admin masuk ke Dashboard Admin Invoice; jika tidak, status menjadi Login Gagal dan admin kembali ke form login. Dari dashboard, Admin Invoice memiliki dua alur kerja. (1) Membuat Invoice dari Sales Order: dari daftar invoice admin dapat input / edit (tersimpan bila semua data sesuai), mencetak, atau menghapus invoice, lalu berakhir dengan pesan sukses. (2) Mencatat Pembayaran: admin menginput / mengedit pembayaran; jika dibatalkan riwayat tampil tanpa menyimpan, jika nominal sesuai tagihan data diproses dan status invoice diperbarui (Lunas / Sebagian), sedangkan bila gagal pencatatan dibatalkan. Pembayaran juga dapat dihapus setelah konfirmasi." vertex="1">
          <mxGeometry height="130" width="1100" x="1292" y="2515" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
