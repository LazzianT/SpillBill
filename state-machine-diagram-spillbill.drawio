        <mxCell id="YnwVOECAVnGj1yR-39HR-76" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Daftar Pelanggan Ditampilkan&lt;/b&gt; : Keadaan setelah halaman pelanggan dimuat. User dapat memilih satu aksi: tambah, edit, lihat detail, atau hapus data." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="1889.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-77" parent="1" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="1935.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-78" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Form Tambah / Edit Terbuka&lt;/b&gt; : Sistem memuat form tambah / edit. User mengisi atau mengubah data lalu menekan Simpan. Jika ada data belum terisi, sistem menampilkan pesan error dan form tetap terbuka." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="1929.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-79" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="1975.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-80" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Data Pelanggan Tersimpan&lt;/b&gt; : Semua data terisi. Sistem memproses simpan data (tambah / edit) lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="1969.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-81" parent="1" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="2015.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-82" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Detail Pelanggan Ditampilkan&lt;/b&gt; : Sistem menampilkan informasi lengkap satu pelanggan. User dapat kembali ke daftar pelanggan." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="2009.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-83" parent="1" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="2055.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-84" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Menunggu Konfirmasi Hapus&lt;/b&gt; : User menekan tombol Hapus. Sistem meminta konfirmasi: jika Tidak kembali ke daftar, jika Ya data diproses untuk dihapus." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="2049.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-85" parent="1" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="719" y="2095.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-86" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingTop=0;" value="&lt;b&gt;Data Pelanggan Dihapus&lt;/b&gt; : Konfirmasi Ya. Sistem menghapus data pelanggan dari sistem lalu menampilkan pesan sukses." vertex="1">
          <mxGeometry height="38" width="585" x="744" y="2089.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="YnwVOECAVnGj1yR-39HR-87" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f7fbff;strokeColor=#6c8ebf;" value="&lt;b&gt;Penjelasan Alur :&lt;/b&gt; Sistem diawali ketika user membuka halaman pelanggan sehingga Daftar Pelanggan Ditampilkan. Dari daftar, user memilih satu aksi. Pada aksi tambah / edit, form dibuka lalu user menekan Simpan: jika semua data terisi maka data tersimpan dan pesan sukses ditampilkan (final state), jika belum maka pesan error muncul dan user tetap di form. Pada aksi hapus, sistem meminta konfirmasi: jika Ya data dihapus dan pesan sukses ditampilkan, jika Tidak kembali ke daftar. Pada aksi lihat detail, sistem menampilkan detail pelanggan lalu user dapat kembali ke daftar." vertex="1">
          <mxGeometry height="92" width="980" x="364" y="2167.2000122070312" as="geometry" />
        </mxCell>
