# Public URL used by browsers. Rebuild frontend after changing.
VITE_API_URL=http://YOUR_VPS_IP:1002

# Backend runtime
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://YOUR_VPS_IP:1001

# MySQL reachable from the backend container
DB_HOST=YOUR_MYSQL_HOST_OR_DOCKER_GATEWAY
DB_PORT=3306
DB_NAME=twizzi
DB_USER=spillbill_dev
DB_PASSWORD=replace-with-database-password
DB_CONNECTION_LIMIT=5
DB_SSL=false
